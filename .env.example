# Gemini API
GEMINI_API_KEY=your_api_key_here

# Database
DATABASE_PATH=data/app.db

# Cache settings
CACHE_TTL_SECONDS=86400
MAX_CACHE_SIZE=1000

# Learning settings
ENABLE_LEARNING=true
LEARNING_CONFIDENCE_THRESHOLD=0.85
LEARNING_MIN_OCCURRENCES=3

# API settings
API_HOST=0.0.0.0
API_PORT=8000

# Logging
LOG_LEVEL=INFO
