# DeepSeek API
DEEPSEEK_API_KEY=your_api_key_here

# Database - MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=apiuser
DB_PASSWORD=apipassword
DB_NAME=segmentation

# MySQL Root Password (for Docker only)
MYSQL_ROOT_PASSWORD=rootpassword

# Cache settings
CACHE_TTL_SECONDS=86400
MAX_CACHE_SIZE=1000

# Learning settings
ENABLE_LEARNING=true
LEARNING_CONFIDENCE_THRESHOLD=0.85
LEARNING_MIN_OCCURRENCES=3

# Processing mode
# true = LLM-first mode (early stage: always use LLM, learn to dictionary)
# false = Dictionary-first mode (production: use dictionary, fallback to LLM for unknowns)
USE_LLM_FIRST=true

# API settings
API_HOST=0.0.0.0
API_PORT=8000

# Logging
LOG_LEVEL=INFO
